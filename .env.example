# Backend configuration (see docs/BLUEPRINT.md §21).
# Copy to backend/.env for local development. Never commit the real file.

# development | production - "production" disables the interactive
# /docs, /redoc and /openapi.json endpoints.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/intervue.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=15.0
GEMINI_MAX_RETRIES=1
# Comma-free JSON array of allowed frontend origins. In production this
# must be the deployed frontend's exact origin(s), e.g.
# ["https://intervue-ai.vercel.app"] - never a wildcard.
ALLOWED_ORIGINS=["http://localhost:3000"]

MAX_SESSION_DURATION_MINUTES=60
MAX_QUESTIONS_PER_SESSION=40
RATE_LIMIT_PER_MINUTE=20
