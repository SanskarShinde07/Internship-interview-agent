# Backend configuration (see docs/BLUEPRINT.md §21).
# Copy to backend/.env for local development. Never commit the real file.

# development | production - "production" disables the interactive
# /docs, /redoc and /openapi.json endpoints.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/intervue.db
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=15.0
GEMINI_MAX_RETRIES=1
# Comma-free JSON array of allowed frontend origins. In production this
# must be the deployed frontend's exact origin(s), e.g.
# ["https://intervue-ai.vercel.app"] - never a wildcard.
ALLOWED_ORIGINS=["http://localhost:3000"]

MAX_SESSION_DURATION_MINUTES=60
MAX_QUESTIONS_PER_SESSION=40
RATE_LIMIT_PER_MINUTE=20

# Auth. JWT_SECRET_KEY has NO safe default - the app refuses to start in
# production without one. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
AUTH_RATE_LIMIT_PER_MINUTE=10

# Password-reset emails via Resend (https://resend.com/api-keys). Leave
# blank in local dev - the reset link is logged instead of emailed (see
# app/core/email.py).
RESEND_API_KEY=
EMAIL_FROM=InterVue AI <onboarding@resend.dev>
# Used to build the password-reset link sent to candidates - must be the
# deployed frontend's origin, no trailing slash.
FRONTEND_URL=http://localhost:3000
